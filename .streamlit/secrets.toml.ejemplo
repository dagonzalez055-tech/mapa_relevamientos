# Copiá este archivo como .streamlit/secrets.toml (en la PC) o pegá su contenido en
# Streamlit Community Cloud > tu app > Settings > Secrets. NUNCA lo subas a GitHub.

[auth]
# Dirección de TU app + /oauth2callback (en la PC: http://localhost:8501/oauth2callback)
redirect_uri = "https://NOMBRE-DE-TU-APP.streamlit.app/oauth2callback"
# Una cadena larga y aleatoria (ver GUIA_PUBLICACION.md, paso 4)
cookie_secret = "CAMBIAR-por-una-cadena-larga-y-aleatoria"
# Los dos primeros datos los da Google Cloud Console (ver la guía, paso 3)
client_id = "CAMBIAR.apps.googleusercontent.com"
client_secret = "CAMBIAR"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[supabase]
url = "https://CAMBIAR.supabase.co"
# Clave SECRETA (secret key / service_role). No la compartas ni la subas a GitHub.
key = "CAMBIAR"

[app]
# Administradores: siempre pueden entrar, aunque no figuren en la tabla de usuarios.
admins = ["CORREO-DEL-ADMINISTRADOR@gmail.com"]
